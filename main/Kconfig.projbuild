# 节点项目配置（编译期「项目即宏」选择，对标 esp32-xiaozhi 的板型选择机制）
#
# 在本菜单选一个项目（或在 ESP-IDF shell 执行 python scripts/release.py <项目> 一键构建）：
# 项目宏通过 select 自动锁定显示屏 / 传感器 / 触摸等内部开关，组件层无需感知。
#
# 每个项目对应 main/boards/<name>/ 目录：
#   config.h         板级编译期常量（引脚/通道等，仅本项目 <Xxx>Board.cpp include）
#   config.json      构建元数据（target 芯片 + sdkconfig 追加项，供 release.py 使用）
#   <Xxx>Board.cpp   装配实现（本项目唯一知道具体硬件组合的文件）
#
# 新增项目步骤：
#   1. 新建 main/boards/<name>/{config.h,config.json,<Xxx>Board.hpp,<Xxx>Board.cpp}
#   2. 在下方 NODE_PROJECT choice 加一个 config，并用 select 锁定所需内部符号
#   3. 在 main/CMakeLists.txt 加一个 elseif(CONFIG_NODE_PROJECT_<NAME>) 映射目录

menu "Node project"

    choice NODE_PROJECT
        prompt "Project profile"
        default NODE_PROJECT_S3_TFT_FAN
        help
            选择目标项目。项目决定芯片、显示屏、传感器与外设的全套组合，
            对应 main/boards/<name>/ 目录。
            也可在 ESP-IDF shell 中执行 python scripts/release.py <项目> 一键构建。

        config NODE_PROJECT_C3_OLED_THP
            bool "C3 OLED 温湿度气压节点 (SSD1315 + SHT3X + BMP180)"
            select NODE_SENSOR_SHT3X
            select NODE_SENSOR_BMP180
            select NODE_DISPLAY_SSD1315

        config NODE_PROJECT_C3_OLED_VOC
            bool "C3 OLED 甲醛空气质量节点 (SSD1315 + 21VOC)"
            select NODE_SENSOR_VOC21
            select NODE_DISPLAY_SSD1315

        config NODE_PROJECT_S3_TFT_FAN
            bool "S3 TFT 风扇控制节点 (ILI9341 + XPT2046 + AHT20 + BMP280)"
            select NODE_SENSOR_AHT20
            select NODE_SENSOR_BMP280
            select NODE_DISPLAY_ILI9341_240X320
            select NODE_TOUCH_XPT2046
    endchoice

    # ----------------------------------------------------------------------
    # 内部开关：无 prompt，不在 menuconfig 显示，完全由所选项目的 select 锁定。
    # 各组件 CMakeLists.txt 按这些符号条件编入源文件，源码中也可 #if 使用。
    # 新增项目时只需在上方 choice 里 select 它们，不要给它们加 prompt。
    # ----------------------------------------------------------------------

    config NODE_SENSOR_SHT3X
        bool

    config NODE_SENSOR_AHT20
        bool

    config NODE_SENSOR_BMP180
        bool

    config NODE_SENSOR_BMP280
        bool

    config NODE_SENSOR_VOC21
        bool

    config NODE_DISPLAY_SSD1315
        bool

    config NODE_DISPLAY_SSD1306_128X32
        bool

    config NODE_DISPLAY_ILI9341_240X320
        bool

    config NODE_TOUCH_XPT2046
        bool

endmenu
