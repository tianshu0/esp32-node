# 节点硬件配置（编译期选择，对标 esp32-xiaozhi 的板型选择机制）
#
# 三个正交维度：
#   NODE_BOARD    板型：引脚映射与整体装配（main/boards/<name>/）
#   NODE_SENSOR_* 挂哪些传感器驱动（多选，未选不编入固件，省 flash/RAM）
#   NODE_DISPLAY  用什么显示屏（单选；未接的屏运行时探测失败会自动禁用）
#
# 新增部件的步骤见 README「硬件扩展」。

menu "Node hardware profile"

    choice NODE_BOARD
        prompt "Board profile"
        help
            选择目标板型。每个板型对应 main/boards/<name>/ 目录，
            其中 Pins.hpp 定义引脚、Board.cpp 负责装配总线/传感器/显示屏。
        # config NODE_BOARD_C3_I2C_OLED
        #     bool "ESP32-C3 + I2C sensors + SSD1315 OLED (default)"
        config NODE_BOARD_S3_SPI_TFT
            bool "ESP32-S3 N16R8 + SPI TFT (ILI9341) + XPT2046 touch"
    endchoice

    menu "Sensors"
        config NODE_SENSOR_SHT3X
            bool "SHT3X temperature/humidity sensor (I2C 0x44/0x45)"
            default n
        config NODE_SENSOR_BMP180
            bool "BMP180 pressure sensor (I2C 0x77)"
            default y
        config NODE_SENSOR_VOC21
            bool "21VOC 5-in-1 air quality module (UART 9600, TVOC/CH2O/eCO2/T/H)"
            default n
    endmenu

    choice NODE_DISPLAY
        prompt "Display"
        help
            选择显示驱动。"显示什么内容"由内容模板（Screen）决定，与驱动解耦。
        # config NODE_DISPLAY_SSD1315
        #     bool "SSD1315 0.96\" 128x64 monochrome I2C OLED"
        # config NODE_DISPLAY_SSD1306_128X32
        #     bool "SSD1306 0.91\" 128x32 monochrome I2C OLED"
        config NODE_DISPLAY_ILI9341_240X320
            bool "ILI9341 2.4\" 240x320 RGB SPI TFT"
        config NODE_DISPLAY_NONE
            bool "No display"
    endchoice

    menu "Automation & I/O"
        config NODE_TOUCH_XPT2046
            bool "XPT2046 resistive touch controller (SPI, shared with LCD)"
            default y
            depends on NODE_DISPLAY_ILI9341_240X320

        config NODE_FAN_PWM
            bool "Enable 1-channel PWM fan control (LEDC, software or hardware)"
            default n

        config NODE_AUTOMATION_RULES
            bool "Enable automation rule engine (sensor threshold -> fan action)"
            default n
            depends on NODE_FAN_PWM
    endmenu

endmenu
