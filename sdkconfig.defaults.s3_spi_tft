# ESP32-S3 N16R8 + SPI TFT (ILI9341) + XPT2046 Touch 默认配置模板
# ================================================================
# 用法：在 ESP-IDF shell 中执行以下步骤：
#   1. idf.py set-target esp32s3          # 切换目标芯片
#   2. idf.py menuconfig                   # 打开配置菜单
#      → Node hardware profile → 选择：
#        Board profile: "ESP32-S3 N16R8 + SPI TFT + XPT2046 touch"
#        Sensors: 勾选 SHT3X / BMP180 / VOC21
#        Display:  "ILI9341 2.4\" 240x320 RGB SPI TFT"
#        Automation: 勾选 XPT2046 / Fan PWM / Automation Rules
#   3. idf.py build                        # 编译
#   4. idf.py -p COMx flash monitor        # 烧录 + 监控

# 芯片目标：ESP32-S3
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# Flash: 16MB (OCTAL)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM: 8MB (OCTAL, 板载 N16R8 = 16MB OCTAL Flash + 8MB OCTAL PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_OCTAL_SPIRAM_ACCESS_DELAY=0
CONFIG_SPIRAM_OCTAL_SPIRAM_INIT_DELAY=0
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384  # 小于 16KB 堆分配放内部 RAM，大的放 PSRAM
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0   # 不预留内部 RAM 给 DMA（DMA 设备用 DMA_MALLOC）

# PSRAM 让 SPI DMA buffer 可以从 PSRAM 分配
# 但 esp_lcd 面板 SPI 要求 DMA buffer 内部 RAM
# esp_lvgl_port 的 buff_dma=true 会自动处理

# 增大主任务栈（C++ 组件 + LVGL + Automation）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# 分区表（沿用默认 4MB，S3 16MB 更大可以调整）
CONFIG_PARTITION_TABLE_DEFAULT=y
CONFIG_PARTITION_TABLE_CUSTOM=n

# BLE：NimBLE Peripheral（和 C3 节点相同配置）
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

# LVGL 配置（S3 + PSRAM，内存池 32KB；LVGL 9.6 用字节单位）
CONFIG_LV_MEM_SIZE=32768

# 需要的字号
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# S3 特有：高速 SPI LCD 需要 DMA 内存
# SPI DMA buffer 必须在内部 RAM（不是 PSRAM）
# esp_lvgl_port 会用 heap_caps_malloc(MALLOC_CAP_DMA) 分配

# 降低 PSRAM 频率以提高稳定性（可选）
# CONFIG_SPIRAM_SPEED_80M=y  # 默认 80MHz
# CONFIG_SPIRAM_SPEED_40M=y  # 如果不稳定降到 40MHz

# 降低内核优先级配置
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# 低功耗（先关闭，调试稳定后再开）
CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
