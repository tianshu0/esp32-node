# esp32-node 通用默认配置（所有项目共享的最小集合）
# =====================================================================
# 目标芯片、蓝牙、分区表、Flash 大小、PSRAM、LVGL 内存池/字号、低功耗等
# 项目间差异配置不放本文件，由各项目 main/projects/<name>/config.json
# 的 builds.sdkconfig_append 提供，构建时经 release.py 生成为 fragment 拼接到本文件之后。
#
# 推荐构建方式（在已初始化的 ESP-IDF shell 中，仓库根目录）：
#   python scripts/release.py --list                 # 列出全部项目
#   python scripts/release.py <项目>                 # 配置 + 编译
#   python scripts/release.py <项目> --flash -p COM7 # 编译 + 烧录
#   python scripts/release.py <项目> --flash --monitor -p COM7
#
# 手动方式（不经过 release.py）：
#   idf.py set-target <esp32c3|esp32s3>
#   idf.py menuconfig   # -> Node project -> Project profile -> 选择项目
#   idf.py build
#   注意：项目专属的 sdkconfig 项（BT/LVGL/PSRAM 等）需自行参照对应 config.json 勾选。
# =====================================================================

# 主任务栈：容纳 C++ 组件初始化（NimBLE + 组件装配）
# S3 项目在其 config.json 中覆盖为 10240
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
